  },
  "devDependencies": {
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/node": "24.5.2",
    "@vitejs/plugin-react": "5.0.3",
    "vite": "7.1.7",
    "typescript": "5.9.2",
    "tsx": "4.20.5"
  }
