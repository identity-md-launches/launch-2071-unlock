out/
cache/
broadcast/
test/scratch/
__pycache__/
*.py[cod]

# Website path budget: dependency installs only; production dist remains included.
**/node_modules/

# Explicit delivery path budget: these five files only. Overrides the local
# artifacts exclusion without allowing caches or other generated packaging.
!/artifacts/
/artifacts/*
!/artifacts/validation.md
!/artifacts/https-results.json
!/artifacts/terminal-desktop.jpg
!/artifacts/terminal-mobile.jpg
!/artifacts/terminal-mobile-ladder.jpg

# Explicit revision-response path budget: this root JSON only, at most 4096 bytes.
!/.imd-responses.json

# Explicit repair evidence path budget: artifacts/repair/ <= 2 MiB total.
# Validation reports, read-only chain evidence, compressed screenshots, and one incremental Git commit bundle.
!/artifacts/repair/
!/artifacts/repair/**

# Explicit chart evidence path budget: artifacts/chart/ <= 1.5 MiB total.
# Before/after compressed screenshots, source checks and validation only.
!/artifacts/chart/
!/artifacts/chart/**
