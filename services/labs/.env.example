# Operator-owned deployment settings. No wallet private keys are used.
LABS_SITE_ORIGIN=https://unlk-b35c.sites.imd.fun
LABS_HOST=127.0.0.1
LABS_PORT=8787
LABS_DB_PATH=/data/labs.sqlite
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# Set a real operator wallet to enable owner configuration/moderation; blank disables both.
LABS_OPERATOR_OWNER=
# Optional absolute path to operator's market config. Empty = no representative simulations.
LABS_MARKET_CONFIG=
# Optional actual API hostname for Caddy, never a fabricated public endpoint.
LABS_API_HOST=
