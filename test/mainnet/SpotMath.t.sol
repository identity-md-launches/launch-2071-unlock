    function testExactInvertedThresholdAboveUint128HasNoNormalizationLoss() public pure {
        uint160 sqrtPrice = 757754551154547587017754130329757827804493771339;
        uint256 imdUsd = 9147405665873895824972938991544784929719048921092085;
        assertEq(ImdSpotMath.fdv(sqrtPrice, imdUsd * 1_000_000_000, false), 100000 ether);
    }

    function testFuzzPowerOfTwoPricesAreExactInBothOrders(uint256 base, uint8 raw) public pure {
        uint256 exponent = 129 + uint256(raw) % 31;
        uint160 sqrtPrice = uint160(uint256(1) << exponent);
        uint256 shift = 2 * exponent - 192;
        uint256 expected = base > type(uint256).max >> shift ? type(uint256).max : base << shift;
        assertEq(ImdSpotMath.fdv(sqrtPrice, base, true), expected);
        assertEq(ImdSpotMath.fdv(sqrtPrice, base, false), base >> shift);
    }
